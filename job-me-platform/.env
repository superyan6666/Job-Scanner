# Job Me Platform 配置
# 复制此文件为 .env 并修改

# 服务端口
PORT=3000
HOST=0.0.0.0

# 浏览器设置
BROWSER_HEADLESS=true

# AI 接口 (免费方案任选)
# ─── 方案1: DeepSeek (最便宜, 性价比最高) ───
AI_PROVIDER=deepseek
AI_ENDPOINT=https://api.deepseek.com/v1/chat/completions
AI_API_KEY=sk-your-deepseek-key-here
AI_MODEL=deepseek-chat

# ─── 方案2: SiliconFlow (有免费额度) ───
# AI_PROVIDER=siliconflow
# AI_ENDPOINT=https://api.siliconflow.cn/v1/chat/completions
# AI_API_KEY=sk-your-siliconflow-key-here
# AI_MODEL=deepseek-ai/DeepSeek-V2.5

# ─── 方案3: Ollama 本地 (完全免费) ───
# AI_PROVIDER=ollama
# AI_ENDPOINT=http://localhost:11434/v1/chat/completions
# AI_API_KEY=ollama
# AI_MODEL=qwen2.5:7b

# 投递设置
MAX_DELIVERY=50
DELAY_JOBS=4000
DELAY_JITTER=2000

# 数据库
DB_PATH=./data/jobme.db